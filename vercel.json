{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/((?!_expo/static).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon.ico|metadata.json).*)",
      "destination": "/index.html"
    }
  ]
}
